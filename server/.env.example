# ==========================================
# RentHub Server Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Atlas Connection URI (MANDATORY)
# Replace with your actual MongoDB Atlas cluster credentials
# Example: mongodb+srv://username:password@cluster0.abcde.mongodb.net/renthub?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/renthub?retryWrites=true&w=majority

# JWT Authentication Secret & Expiration
JWT_SECRET=renthub_super_secret_jwt_key_2026_secure
JWT_EXPIRE=30d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional: Cloudinary Configuration for Image Storage
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Optional: Razorpay Test Mode Keys
# RAZORPAY_KEY_ID=rzp_test_yourkey
# RAZORPAY_KEY_SECRET=your_key_secret

